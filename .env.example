# Core runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/calendar-bot.sqlite
REMINDER_POLL_INTERVAL_SECONDS=60

# Discord: set both values before enabling the bot integration.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# Google OAuth: set all three values together before linking an account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://calendar.example.com/oauth/google/callback

# Generate a random, base64url-compatible secret with at least 32 characters.
ENCRYPTION_KEY=

# Optional Gemini fallback for complex natural-language requests.
GEMINI_API_KEY=
GEMINI_MODEL=
