# Core runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/calendar-bot.sqlite
REMINDER_POLL_INTERVAL_SECONDS=60

# Local task behavior. Use a valid IANA zone; America/Toronto is the default.
LOCAL_TASK_TIME_ZONE=America/Toronto

# Discord and encrypted local state: set all three values to enable the bot.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# Generate a random, base64url-compatible secret with at least 32 characters.
# It encrypts OAuth credentials, pending actions, and locally stored task titles.
ENCRYPTION_KEY=

# Optional Google Calendar integration: set all three values together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://calendar.example.com/oauth/google/callback

# Optional Gemini fallback. In a private environment, set both values or leave both blank.
# GEMINI_API_KEY is secret; GEMINI_MODEL is a non-secret supported model identifier.
GEMINI_API_KEY=
GEMINI_MODEL=
